<Window
    x:Class="AutoCronos.Desktop.Windows.EmailSettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="AutoCronos | Integracao de e-mail"
    Width="620"
    Height="390"
    WindowStartupLocation="CenterScreen"
    Background="#F5F7FA">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="Conecte sua conta Google" FontSize="28" FontWeight="SemiBold" Foreground="#172033" />
            <TextBlock Text="Autorize o AutoCronos a ler os comunicados e organizar sua caixa com marcadores." Margin="0,4,0,0" Foreground="#61708A" TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1" Background="White" BorderBrush="#D6DCE6" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock x:Name="StatusTextBlock" FontWeight="SemiBold" Foreground="#172033" />
                <TextBlock x:Name="DetailTextBlock" Margin="0,6,0,0" Foreground="#61708A" TextWrapping="Wrap" />
                <TextBlock x:Name="ConnectedEmailTextBlock" Margin="0,8,0,0" Foreground="#33445F" FontWeight="SemiBold" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="White" BorderBrush="#D6DCE6" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Credenciais protegidas" Foreground="#33445F" FontWeight="SemiBold" />
                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#61708A">
                    O Client ID e o Client Secret sao lidos somente do JSON local em secret_Key.
                    Os valores nao sao exibidos, nao sao copiados para as configuracoes salvas e nao entram no historico do Git.
                </TextBlock>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="DisconnectButton" Content="Desconectar" Click="Disconnect_Click" Padding="14,8" Background="#FCEBEA" Foreground="#A4382E" BorderThickness="0" Margin="0,0,8,0" />
            <Button x:Name="SyncButton" Content="Sincronizar agora" Click="Sync_Click" Padding="14,8" Background="White" BorderBrush="#D6DCE6" Margin="0,0,8,0" />
            <Button x:Name="ConnectButton" Content="Conectar com Google" Click="Connect_Click" Padding="14,8" Background="#153A5B" Foreground="White" BorderThickness="0" />
        </StackPanel>
    </Grid>
</Window>
