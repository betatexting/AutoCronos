<local:ChromeWindow
    x:Class="AutoCronos.Desktop.Windows.EmailSettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:AutoCronos.Desktop.Windows"
    Title="AutoCronos | Integracao de e-mail"
    Width="764"
    Height="523"
    MinWidth="620"
    MinHeight="460"
    WindowStyle="None"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterScreen"
    Background="#000000"
    FontFamily="./Assets/Fonts/#Bebas Neue">
    <Grid ClipToBounds="True">
            <Image Source="/Assets/background-symbol.png"
                   Stretch="UniformToFill"
                   IsHitTestVisible="False" />

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="61" />
                    <RowDefinition Height="98" />
                    <RowDefinition Height="180" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="80" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Background="Transparent"
                            MouseLeftButtonDown="ChromeTitleBar_MouseLeftButtonDown" />
                    <StackPanel Orientation="Horizontal"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,20,0">
                        <Button Style="{StaticResource ChromeWindowControlButton}"
                                Content="−"
                                Click="ChromeMinimize_Click"
                                ToolTip="Minimizar" />
                        <Button Style="{StaticResource ChromeWindowControlButton}"
                                Content="□"
                                FontSize="18"
                                Click="ChromeMaximizeRestore_Click"
                                ToolTip="Maximizar ou restaurar" />
                        <Button Style="{StaticResource ChromeWindowControlButton}"
                                Content="×"
                                FontSize="24"
                                Margin="0"
                                Click="ChromeClose_Click"
                                ToolTip="Fechar" />
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="1"
                           Margin="20,0,20,17"
                           VerticalAlignment="Bottom"
                           Text="CONECTE SUA CONTA GOOGLE"
                           Foreground="#F7F7F7"
                           FontSize="26" />

                <Border Grid.Row="2"
                        Height="162"
                        Margin="49,19,54,0"
                        Padding="23,18"
                        VerticalAlignment="Top"
                        Background="#242424"
                        CornerRadius="8">
                    <Grid>
                        <TextBlock x:Name="StatusTextBlock"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"
                                   Foreground="#F2F2F2"
                                   FontSize="12" />
                        <TextBlock x:Name="DetailTextBlock"
                                   MaxHeight="50"
                                   Margin="0,38,0,0"
                                   VerticalAlignment="Top"
                                   Foreground="#B7B7B7"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ConnectedEmailTextBlock"
                                   Margin="0,0,0,-1"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom"
                                   Foreground="#ECECEC"
                                   FontSize="10"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>

                <StackPanel Grid.Row="4"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,19,0">
                    <Button x:Name="DisconnectButton"
                            Width="131"
                            Margin="0,0,20,0"
                            Style="{StaticResource DisconnectActionButton}"
                            Content="DESCONECTAR"
                            Click="Disconnect_Click" />
                    <Button x:Name="ConnectButton"
                            Width="132"
                            Style="{StaticResource ConnectActionButton}"
                            Content="CONECTAR OUTRA CONTA"
                            Click="Connect_Click" />
                    <Button x:Name="SyncButton"
                            Visibility="Collapsed"
                            Content="SINCRONIZAR AGORA"
                            Click="Sync_Click" />
                </StackPanel>
            </Grid>
    </Grid>
</local:ChromeWindow>
