<local:ChromeWindow
    x:Class="AutoCronos.Desktop.Windows.WarningWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:AutoCronos.Desktop.Windows"
    Title="AutoCronos | Pendências"
    Width="540"
    Height="370"
    MinWidth="480"
    MinHeight="330"
    WindowStyle="None"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterScreen"
    Background="#000000"
    FontFamily="./Assets/Fonts/#Bebas Neue">
    <local:ChromeWindow.Resources>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,15" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </local:ChromeWindow.Resources>

    <Border BorderBrush="#171717" BorderThickness="1">
        <Grid ClipToBounds="True">
            <Image Source="/Assets/background-symbol.png"
                   Width="360"
                   Height="360"
                   Stretch="Uniform"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Margin="0,0,-54,-26"
                   IsHitTestVisible="False" />

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="45" />
                    <RowDefinition Height="60" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Background="Transparent"
                            MouseLeftButtonDown="ChromeTitleBar_MouseLeftButtonDown" />
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,15,0">
                        <Button Style="{StaticResource ChromeWindowControlButton}"
                                Content="−"
                                Click="ChromeMinimize_Click"
                                ToolTip="Minimizar" />
                        <Button Style="{StaticResource ChromeWindowControlButton}"
                                Content="□"
                                FontSize="15"
                                Click="ChromeMaximizeRestore_Click"
                                ToolTip="Maximizar ou restaurar" />
                        <Button Style="{StaticResource ChromeWindowControlButton}"
                                Content="×"
                                FontSize="20"
                                Margin="0"
                                Click="ChromeClose_Click"
                                ToolTip="Fechar" />
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="1"
                           Margin="24,0,24,8"
                           VerticalAlignment="Bottom"
                           Text="PENDÊNCIAS"
                           Foreground="#F7F7F7"
                           FontSize="22" />

                <ListBox Grid.Row="2"
                         Margin="62,0,62,18"
                         ItemsSource="{Binding}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Hidden"
                         ScrollViewer.CanContentScroll="False"
                         PreviewMouseWheel="PendingItems_PreviewMouseWheel">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border MinHeight="95"
                                    Padding="12,10"
                                    Background="#2D2D2D"
                                    CornerRadius="5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Margin="0,0,9,0">
                                        <TextBlock Text="{Binding Title}"
                                                   Foreground="#F0F0F0"
                                                   FontSize="9"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding CompanyName}"
                                                   Margin="0,13,0,0"
                                                   Foreground="#B5B5B5"
                                                   FontSize="8"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding TaxId}"
                                                   Margin="0,1,0,0"
                                                   Foreground="#9A9A9A"
                                                   FontSize="8" />
                                        <TextBlock Text="{Binding Description}"
                                                   Margin="0,11,0,0"
                                                   Foreground="#E0E0E0"
                                                   FontSize="8"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Button Style="{StaticResource ApproveActionButton}"
                                                Content="APROVAR"
                                                Tag="{Binding}"
                                                CommandParameter="True"
                                                Click="Resolve_Click" />
                                        <Button Style="{StaticResource RejectActionButton}"
                                                Margin="0,10,0,0"
                                                Content="RECUSAR"
                                                Tag="{Binding}"
                                                CommandParameter="False"
                                                Click="Resolve_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
    </Border>
</local:ChromeWindow>
