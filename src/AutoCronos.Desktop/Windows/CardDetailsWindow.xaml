<Window
    x:Class="AutoCronos.Desktop.Windows.CardDetailsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Detalhes do card"
    Width="620"
    Height="650"
    MinWidth="520"
    MinHeight="520"
    WindowStartupLocation="CenterOwner"
    Background="#F5F7FA">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="HeadingTextBlock" Text="Detalhes do card" FontSize="24" FontWeight="SemiBold" Foreground="#172033" />
            <TextBlock x:Name="DescriptionTextBlock" Text="Edite as informacoes e salve para atualizar o quadro." Margin="0,5,0,18" Foreground="#61708A" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="Razao social" FontWeight="SemiBold" Foreground="#27344B" />
                <TextBox x:Name="CompanyNameTextBox" Margin="0,6,0,16" Padding="9,7" TextWrapping="Wrap" />

                <TextBlock Text="CPF/CNPJ" FontWeight="SemiBold" Foreground="#27344B" />
                <TextBox x:Name="TaxIdTextBox" Margin="0,6,0,16" Padding="9,7" />

                <TextBlock Text="Competencia" FontWeight="SemiBold" Foreground="#27344B" />
                <TextBox x:Name="CompetenceTextBox" Margin="0,6,0,16" Padding="9,7" />

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Prazo" FontWeight="SemiBold" Foreground="#27344B" />
                        <DatePicker x:Name="DeadlineDatePicker" Margin="0,6,0,0" Padding="7,5" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Coluna" FontWeight="SemiBold" Foreground="#27344B" />
                        <ComboBox x:Name="ColumnComboBox" Margin="0,6,0,0" Padding="7,5" />
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="OriginDetailsPanel">
                    <TextBlock Text="Recebido em" FontWeight="SemiBold" Foreground="#27344B" />
                    <TextBlock x:Name="ReceivedAtTextBlock" Margin="0,6,0,16" Foreground="#61708A" />

                    <TextBlock Text="Assunto do e-mail de origem" FontWeight="SemiBold" Foreground="#27344B" />
                    <TextBox x:Name="EmailSubjectTextBox" Margin="0,6,0,8" Padding="9,7" TextWrapping="Wrap" IsReadOnly="True" Background="#EEF2F7" Foreground="#4D5B72" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancelar" IsCancel="True" Padding="14,7" Margin="0,0,8,0" Background="White" BorderBrush="#D6DCE6" />
            <Button x:Name="SaveButton" Content="Salvar" Click="Save_Click" Padding="16,7" Background="#153A5B" Foreground="White" BorderThickness="0" />
        </StackPanel>
    </Grid>
</Window>
