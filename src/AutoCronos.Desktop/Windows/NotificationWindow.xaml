<Window
    x:Class="AutoCronos.Desktop.Windows.NotificationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="390"
    Height="130"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    ShowActivated="False"
    Topmost="True">
    <Border Background="#153A5B" CornerRadius="14" Padding="18" BorderBrush="#FFFFFF" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TitleTextBlock" FontSize="16" FontWeight="SemiBold" Foreground="White" />
                <TextBlock x:Name="MessageTextBlock" Margin="0,7,8,0" Foreground="#E7EEF7" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" Content="&#x00D7;" Click="Close_Click" ToolTip="Marcar como lida" Width="26" Height="26" Padding="0" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="18" VerticalAlignment="Top" />
        </Grid>
    </Border>
</Window>
