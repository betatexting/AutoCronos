<local:ChromeWindow
    x:Class="AutoCronos.Desktop.Windows.WhatsAppMonitorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:AutoCronos.Desktop.Windows"
    Title="AutoCronos | Atendimentos"
    Width="1120"
    Height="720"
    MinWidth="900"
    MinHeight="560"
    WindowStyle="None"
    Background="#111111">
    <Window.Resources>
        <Style x:Key="SummaryCard" TargetType="Border">
            <Setter Property="Background" Value="#1B1B1B" />
            <Setter Property="BorderBrush" Value="#303030" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="Tag" Value="Selected">
                    <Setter Property="Background" Value="#252525" />
                    <Setter Property="BorderBrush" Value="#00A884" />
                    <Setter Property="BorderThickness" Value="2" />
                    <Setter Property="Padding" Value="15,11" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E8E8E8" />
            <Setter Property="Margin" Value="0,5" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#202020" />
            <Setter Property="Foreground" Value="#F1F1F1" />
            <Setter Property="BorderBrush" Value="#3B3B3B" />
            <Setter Property="Padding" Value="9,6" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#181818" BorderBrush="#303030" BorderThickness="0,0,0,1" MouseLeftButtonDown="ChromeTitleBar_MouseLeftButtonDown">
            <Grid>
                <TextBlock Margin="14,0" VerticalAlignment="Center" Foreground="#F0F0F0" FontFamily="./Assets/Fonts/#Bebas Neue" FontSize="13" Text="AUTOCronos  |  ATENDIMENTOS" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Content="&#x2013;" Style="{StaticResource ChromeWindowControlButton}" Click="ChromeMinimize_Click" />
                    <Button Content="&#x25A1;" Style="{StaticResource ChromeWindowControlButton}" Click="ChromeMaximizeRestore_Click" />
                    <Button Content="&#x00D7;" Style="{StaticResource ChromeWindowControlButton}" Click="ChromeClose_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="218" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#181818" BorderBrush="#303030" BorderThickness="1" CornerRadius="4" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Foreground="White" FontFamily="./Assets/Fonts/#Bebas Neue" FontSize="16" Text="SETORES VISÍVEIS" />
                    <StackPanel Grid.Row="1" Margin="0,10,0,8" Orientation="Horizontal">
                        <Button Content="TODOS" Style="{StaticResource CompactActionButton}" Width="70" Margin="0,0,6,0" Click="ShowAllSectors_Click" />
                        <Button Content="NENHUM" Style="{StaticResource CompactActionButton}" Width="70" Background="#4A4A4A" Click="HideAllSectors_Click" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="SectorItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsVisible}" Tag="{Binding Id}" Checked="SectorVisibility_Changed" Unchecked="SectorVisibility_Changed">
                                        <TextBlock>
                                            <Run Text="{Binding Name}" /><Run Text="  (" /><Run Text="{Binding OpenCount}" /><Run Text=")" />
                                        </TextBlock>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel Grid.Row="3" Margin="0,14,0,0">
                        <TextBlock Foreground="#A9A9A9" FontSize="11" Text="TEMPO DE RETORNO (MINUTOS)" />
                        <TextBox x:Name="ResponseTimeTextBox" Margin="0,5,0,0" LostKeyboardFocus="ResponseTimeTextBox_LostKeyboardFocus" KeyDown="ResponseTimeTextBox_KeyDown" />
                        <TextBlock Margin="0,7,0,0" Foreground="#777777" FontSize="10" TextWrapping="Wrap" Text="As preferências são salvas automaticamente para este usuário." />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="OpenSummaryCard" Grid.Column="0" Style="{StaticResource SummaryCard}" MouseLeftButtonDown="SummaryCard_MouseLeftButtonDown" Uid="Open">
                        <StackPanel><TextBlock Foreground="#8E8E8E" FontSize="10" Text="ABERTOS" /><TextBlock x:Name="OpenCountTextBlock" Foreground="White" FontSize="27" FontWeight="SemiBold" /></StackPanel>
                    </Border>
                    <Border x:Name="WaitingSummaryCard" Grid.Column="1" Style="{StaticResource SummaryCard}" MouseLeftButtonDown="SummaryCard_MouseLeftButtonDown" Uid="Waiting">
                        <StackPanel><TextBlock Foreground="#8E8E8E" FontSize="10" Text="AGUARDANDO" /><TextBlock x:Name="WaitingCountTextBlock" Foreground="#F0B35A" FontSize="27" FontWeight="SemiBold" /></StackPanel>
                    </Border>
                    <Border x:Name="InServiceSummaryCard" Grid.Column="2" Style="{StaticResource SummaryCard}" MouseLeftButtonDown="SummaryCard_MouseLeftButtonDown" Uid="InService">
                        <StackPanel><TextBlock Foreground="#8E8E8E" FontSize="10" Text="EM ATENDIMENTO" /><TextBlock x:Name="InServiceCountTextBlock" Foreground="#6DA9E4" FontSize="27" FontWeight="SemiBold" /></StackPanel>
                    </Border>
                    <Border x:Name="TemplateSummaryCard" Grid.Column="3" Style="{StaticResource SummaryCard}" MouseLeftButtonDown="SummaryCard_MouseLeftButtonDown" Uid="Template">
                        <StackPanel><TextBlock Foreground="#8E8E8E" FontSize="10" Text="TEMPLATES" /><TextBlock x:Name="TemplateCountTextBlock" Foreground="#B58CE6" FontSize="27" FontWeight="SemiBold" /></StackPanel>
                    </Border>
                    <Border x:Name="OverdueSummaryCard" Grid.Column="4" Style="{StaticResource SummaryCard}" Margin="0" MouseLeftButtonDown="SummaryCard_MouseLeftButtonDown" Uid="Overdue">
                        <StackPanel><TextBlock Foreground="#8E8E8E" FontSize="10" Text="ACIMA DO PRAZO" /><TextBlock x:Name="OverdueCountTextBlock" Foreground="#EC7373" FontSize="27" FontWeight="SemiBold" /></StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="1" Margin="0,16,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchTextBox" TextChanged="SearchTextBox_TextChanged" ToolTip="Pesquisar por contato, telefone ou protocolo" />
                    <TextBlock Grid.Column="1" x:Name="SyncStatusTextBlock" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="#858585" FontSize="11" />
                    <Button Grid.Column="2" Content="EXPORTAR" Style="{StaticResource CompactActionButton}" Width="82" Margin="14,0,0,0" Click="ExportFilteredConversations_Click" />
                </Grid>

                <Border Grid.Row="2" Background="#202020" BorderBrush="#333333" BorderThickness="1" Padding="10,7">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="2*" /><ColumnDefinition Width="0.7*" /><ColumnDefinition Width="0.5*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Foreground="#999999" FontSize="10" Text="CONTATO" />
                        <TextBlock Grid.Column="1" Foreground="#999999" FontSize="10" Text="SETOR" />
                        <TextBlock Grid.Column="2" Foreground="#999999" FontSize="10" Text="STATUS" />
                        <TextBlock Grid.Column="3" Foreground="#999999" FontSize="10" Text="ÚLTIMA MENSAGEM" />
                        <TextBlock Grid.Column="4" Foreground="#999999" FontSize="10" Text="TEMPO" />
                        <TextBlock Grid.Column="5" Foreground="#999999" FontSize="10" Text="NÃO LIDAS" />
                    </Grid>
                </Border>

                <ListBox Grid.Row="3" x:Name="ConversationsListBox" Margin="0,4,0,0" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="ConversationsListBox_SelectionChanged" ToolTip="Clique em uma conversa para abri-la no Suite360">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,3" />
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOverdue}" Value="True"><Setter Property="Background" Value="#341C1C" /></DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#292929" /></Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="10,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.5*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="2*" /><ColumnDefinition Width="0.7*" /><ColumnDefinition Width="0.5*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Foreground="#F0F0F0" Text="{Binding ContactName}" TextTrimming="CharacterEllipsis" /><TextBlock Foreground="#777777" FontSize="10" Text="{Binding Phone}" /></StackPanel>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="#CCCCCC" Text="{Binding SectorName}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="#CCCCCC" Text="{Binding StatusLabel}" />
                                <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="#AFAFAF" Text="{Binding LastMessage}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="4" VerticalAlignment="Center" Foreground="#F0B35A" FontWeight="SemiBold" Text="{Binding ElapsedLabel}" />
                                <TextBlock Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#EC7373" FontWeight="Bold" Text="{Binding UnreadCount}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Border Grid.Row="3" x:Name="IntegrationErrorBorder" Panel.ZIndex="2" Margin="0,4,0,0" Background="#181818" BorderBrush="#713838" BorderThickness="1" CornerRadius="4" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560" Margin="28">
                        <TextBlock HorizontalAlignment="Center" Foreground="#EC7373" FontFamily="./Assets/Fonts/#Bebas Neue" FontSize="18" Text="NÃO FOI POSSÍVEL CARREGAR OS ATENDIMENTOS" />
                        <TextBlock x:Name="IntegrationErrorTextBlock" Margin="0,12,0,0" Foreground="#D0D0D0" TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</local:ChromeWindow>
