<Window
    x:Class="AutoCronos.Desktop.Windows.BoardCreationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Criar novo quadro"
    Width="860"
    Height="820"
    MinWidth="760"
    MinHeight="680"
    WindowStartupLocation="CenterOwner"
    Background="#F5F7FA">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="WindowHeadingTextBlock" Text="Criar novo quadro" FontSize="24" FontWeight="SemiBold" Foreground="#172033" />
            <TextBlock x:Name="WindowDescriptionTextBlock" Text="Defina a estrutura, os campos dos cards, a captura de e-mail e a regra de tempo deste quadro." Margin="0,5,0,18" Foreground="#61708A" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Nome do quadro" FontWeight="SemiBold" Foreground="#27344B" />
                <TextBox x:Name="BoardNameTextBox" Margin="0,6,0,18" Padding="9,7" />

                <StackPanel x:Name="ColumnsEditorPanel">
                    <TextBlock Text="Colunas iniciais" FontWeight="SemiBold" Foreground="#27344B" />
                    <TextBlock Text="Deixe um campo vazio para nao criar aquela coluna. Outras colunas poderao ser adicionadas no quadro." Margin="0,3,0,8" Foreground="#61708A" FontSize="12" />
                    <UniformGrid Columns="2" Margin="0,0,0,18">
                        <TextBox x:Name="Column1TextBox" Text="Recebido" Margin="0,0,7,7" Padding="9,7" />
                        <TextBox x:Name="Column2TextBox" Text="Conferencia" Margin="7,0,0,7" Padding="9,7" />
                        <TextBox x:Name="Column3TextBox" Text="Em Andamento" Margin="0,0,7,7" Padding="9,7" />
                        <TextBox x:Name="Column4TextBox" Text="Concluido" Margin="7,0,0,7" Padding="9,7" />
                        <TextBox x:Name="Column5TextBox" Margin="0,0,7,0" Padding="9,7" />
                    </UniformGrid>
                </StackPanel>

                <Border x:Name="ExistingColumnsPanel" Visibility="Collapsed" Background="#E9F2FA" BorderBrush="#C9DCEC" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="Colunas atuais" FontWeight="SemiBold" Foreground="#27344B" />
                        <TextBlock x:Name="ExistingColumnsTextBlock" Margin="0,4,0,0" Foreground="#49657D" TextWrapping="Wrap" />
                        <TextBlock Text="Adicione ou exclua colunas diretamente no quadro. Esta tela altera somente as regras e os campos." Margin="0,5,0,0" Foreground="#61708A" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <DockPanel Margin="0,0,0,8">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Campos dos cards" FontWeight="SemiBold" Foreground="#27344B" />
                        <TextBlock Text="A origem define qual informacao do e-mail preenche o campo automaticamente." Margin="0,3,0,0" Foreground="#61708A" FontSize="12" />
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Content="+ Adicionar campo" Click="AddField_Click" Padding="10,5" Background="White" BorderBrush="#C9D2DE" Foreground="#153A5B" />
                </DockPanel>

                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="82" />
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="155" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Campo" Foreground="#61708A" FontSize="11" />
                    <TextBlock Grid.Column="1" Text="Tipo" Foreground="#61708A" FontSize="11" Margin="6,0,0,0" />
                    <TextBlock Grid.Column="2" Text="Obrigatorio" Foreground="#61708A" FontSize="11" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="No card" Foreground="#61708A" FontSize="11" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="Origem no e-mail" Foreground="#61708A" FontSize="11" Margin="6,0,0,0" />
                </Grid>
                <ItemsControl x:Name="FieldsItemsControl" Margin="0,0,0,18">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="82" />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="155" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="7,5" />
                                <ComboBox Grid.Column="1" Margin="6,0,0,0" Padding="5,4"
                                          ItemsSource="{Binding DataContext.FieldTypeOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                          DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding FieldType}" />
                                <CheckBox Grid.Column="2" IsChecked="{Binding IsRequired}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <CheckBox Grid.Column="3" IsChecked="{Binding ShowOnCard}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="4" Margin="6,0,0,0" Padding="5,4"
                                          ItemsSource="{Binding DataContext.EmailSourceOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                          DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding EmailSource}" />
                                <Button Grid.Column="5" Content="&#x00D7;" Tag="{Binding}" Click="RemoveField_Click" Margin="6,0,0,0" Padding="0" Background="Transparent" BorderThickness="0" Foreground="#A4382E" FontSize="16" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Regras de captura de e-mail" FontWeight="SemiBold" Foreground="#27344B" />
                <TextBlock Text="Informe um trecho de assunto por linha. A mensagem ira somente para o quadro com a correspondencia mais especifica." Margin="0,3,0,7" Foreground="#61708A" FontSize="12" TextWrapping="Wrap" />
                <TextBox x:Name="SubjectPatternsTextBox" Height="86" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="9,7" TextWrapping="Wrap" Margin="0,0,0,18" />

                <CheckBox x:Name="AutomaticMoveCheckBox" Content="Contabilizar prazo e mover automaticamente quando ele chegar" IsChecked="True" Checked="AutomaticMove_Changed" Unchecked="AutomaticMove_Changed" Foreground="#27344B" FontWeight="SemiBold" />
                <Grid x:Name="AutomaticRulePanel" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Quantidade" Foreground="#27344B" />
                        <TextBox x:Name="DeadlineAmountTextBox" Text="30" Margin="0,6,0,0" Padding="9,7" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="Unidade" Foreground="#27344B" />
                        <ComboBox x:Name="DeadlineUnitComboBox" Margin="0,6,0,0" Padding="7,5" DisplayMemberPath="Label" SelectedValuePath="Value" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Coluna de destino" Foreground="#27344B" />
                        <TextBox x:Name="TargetColumnTextBox" Text="Em Andamento" Margin="0,6,0,0" Padding="9,7" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancelar" IsCancel="True" Padding="14,7" Margin="0,0,8,0" Background="White" BorderBrush="#D6DCE6" />
            <Button x:Name="CreateButton" Content="Criar quadro" Click="Save_Click" Padding="16,7" Background="#153A5B" Foreground="White" BorderThickness="0" />
        </StackPanel>
    </Grid>
</Window>
