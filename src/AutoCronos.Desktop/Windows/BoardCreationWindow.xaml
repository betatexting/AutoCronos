<Window
    x:Class="AutoCronos.Desktop.Windows.BoardCreationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Criar novo quadro"
    Width="560"
    Height="690"
    MinWidth="500"
    MinHeight="620"
    WindowStartupLocation="CenterOwner"
    Background="#F5F7FA">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Criar novo quadro" FontSize="24" FontWeight="SemiBold" Foreground="#172033" />
            <TextBlock Text="Personalize a estrutura e a regra automatica baseada no quadro de Devolucoes." Margin="0,5,0,18" Foreground="#61708A" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="Nome do quadro" FontWeight="SemiBold" Foreground="#27344B" />
                <TextBox x:Name="BoardNameTextBox" Margin="0,6,0,18" Padding="9,7" />

                <TextBlock Text="Colunas iniciais" FontWeight="SemiBold" Foreground="#27344B" />
                <TextBlock Text="Deixe um campo vazio para nao criar aquela coluna." Margin="0,3,0,8" Foreground="#61708A" FontSize="12" />
                <TextBox x:Name="Column1TextBox" Text="Informativo Recebido" Margin="0,0,0,7" Padding="9,7" />
                <TextBox x:Name="Column2TextBox" Text="Conferencia" Margin="0,0,0,7" Padding="9,7" />
                <TextBox x:Name="Column3TextBox" Text="Iniciar Inativacao" Margin="0,0,0,7" Padding="9,7" />
                <TextBox x:Name="Column4TextBox" Text="Em Andamento" Margin="0,0,0,7" Padding="9,7" />
                <TextBox x:Name="Column5TextBox" Text="Concluido" Margin="0,0,0,18" Padding="9,7" />

                <CheckBox x:Name="AutomaticMoveCheckBox" Content="Mover automaticamente quando o prazo chegar" IsChecked="True" Checked="AutomaticMove_Changed" Unchecked="AutomaticMove_Changed" Foreground="#27344B" FontWeight="SemiBold" />
                <Grid x:Name="AutomaticRulePanel" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Prazo em dias" Foreground="#27344B" />
                        <TextBox x:Name="DeadlineDaysTextBox" Text="30" Margin="0,6,0,0" Padding="9,7" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Coluna de destino" Foreground="#27344B" />
                        <TextBox x:Name="TargetColumnTextBox" Text="Iniciar Inativacao" Margin="0,6,0,0" Padding="9,7" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancelar" IsCancel="True" Padding="14,7" Margin="0,0,8,0" Background="White" BorderBrush="#D6DCE6" />
            <Button x:Name="CreateButton" Content="Criar quadro" Click="Create_Click" Padding="16,7" Background="#153A5B" Foreground="White" BorderThickness="0" />
        </StackPanel>
    </Grid>
</Window>
