<Window
    x:Class="AutoCronos.Desktop.Windows.WhatsAppOverdueAlertWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="108"
    Height="108"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    Topmost="True"
    ShowInTaskbar="False"
    ResizeMode="NoResize">
    <Grid>
        <Button x:Name="AlertButton"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                ToolTip="Abrir atendimentos em atraso"
                Click="AlertButton_Click"
                PreviewMouseLeftButtonDown="Draggable_PreviewMouseLeftButtonDown"
                PreviewMouseMove="Draggable_PreviewMouseMove">
            <Grid x:Name="AlertVisual" Width="96" Height="96">
            <Ellipse Fill="#F7F7F7" Stroke="#D7D7D7" StrokeThickness="1">
                <Ellipse.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.45" />
                </Ellipse.Effect>
            </Ellipse>
            <Canvas Width="76" Height="76">
                <Ellipse Canvas.Left="9" Canvas.Top="12" Width="58" Height="58"
                         Fill="Transparent" Stroke="#161616" StrokeThickness="7" />
                <Line X1="38" Y1="12" X2="38" Y2="5" Stroke="#161616" StrokeThickness="7" StrokeStartLineCap="Round" />
                <Line X1="31" Y1="5" X2="45" Y2="5" Stroke="#161616" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Line X1="60" Y1="18" X2="66" Y2="12" Stroke="#161616" StrokeThickness="8" StrokeStartLineCap="Square" />
                <Line X1="38" Y1="24" X2="38" Y2="42" Stroke="#161616" StrokeThickness="6" StrokeEndLineCap="Round" />
                <Line X1="38" Y1="42" X2="53" Y2="51" Stroke="#161616" StrokeThickness="6" StrokeEndLineCap="Round" />
            </Canvas>
            <Border Width="38" Height="38" CornerRadius="19" Background="#FFF7F7" BorderBrush="#D40000" BorderThickness="2"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="CountTextBlock" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#D40000" FontSize="17" FontWeight="Bold" />
            </Border>
            </Grid>
        </Button>
        <Button x:Name="CloseAlertButton"
                Width="22"
                Height="22"
                Margin="0,4,4,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Panel.ZIndex="10"
                Content="&#x00D7;"
                FontFamily="Arial"
                FontSize="16"
                Foreground="#EDEDED"
                Background="#99000000"
                BorderThickness="0"
                Cursor="Hand"
                ToolTip="Ocultar alerta por 5 minutos"
                Click="CloseAlertButton_Click">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="11">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=AlertButton}" Value="True">
                            <Setter Property="Opacity" Value="0.38" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.72" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</Window>
