<Window
    x:Class="AutoCronos.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="AutoCronos | Quadro de tarefas"
    Width="1240"
    Height="700"
    MinWidth="900"
    MinHeight="560"
    Background="#F5F7FA">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,22" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Devolucoes" FontSize="28" FontWeight="SemiBold" Foreground="#172033" />
                <TextBlock Text="Quadro de tarefas e integracao de e-mail" FontSize="14" Foreground="#61708A" Margin="0,4,0,0" />
            </StackPanel>

            <Border
                x:Name="EmailStatusBorder"
                DockPanel.Dock="Right"
                Background="#FFF2D9"
                CornerRadius="14"
                Padding="16,12"
                Width="410">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,12,0">
                        <TextBlock x:Name="EmailStatusTextBlock" FontWeight="SemiBold" Foreground="#7E5613" />
                        <TextBlock x:Name="EmailDetailTextBlock" Margin="0,4,0,0" Foreground="#7E5613" TextWrapping="Wrap" FontSize="12" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button
                            x:Name="ManageEmailButton"
                            Content="Configurar e-mail"
                            Click="ManageEmail_Click"
                            Padding="12,7"
                            Margin="0,0,8,0"
                            Background="White"
                            BorderBrush="#D6DCE6" />
                        <Button
                            x:Name="SyncEmailButton"
                            Content="Sincronizar"
                            Click="SyncEmail_Click"
                            Padding="12,7"
                            Background="#153A5B"
                            Foreground="White"
                            BorderThickness="0" />
                    </StackPanel>
                </Grid>
            </Border>
        </DockPanel>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="ColumnsItemsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="260" Margin="0,0,16,0" Background="#E9EDF3" CornerRadius="14" Padding="13">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="{Binding Name}" FontWeight="SemiBold" Foreground="#27344B" Margin="0,0,0,12" />
                                <ItemsControl ItemsSource="{Binding Cards}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="White" CornerRadius="10" Padding="13" Margin="0,0,0,10">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding CompanyName}" FontWeight="SemiBold" Foreground="#172033" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding TaxId}" Margin="0,4,0,0" Foreground="#61708A" FontSize="12" />
                                                    <TextBlock Text="{Binding DeadlineLabel}" Margin="0,10,0,0" Foreground="#B25B13" FontWeight="SemiBold" FontSize="12" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
