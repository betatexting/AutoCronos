<Window x:Class="AutoCronos.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AutoCronos | Quadro de tarefas" Height="700" Width="1240" MinHeight="520" MinWidth="850" Background="#F5F7FA">
    <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,22"><StackPanel DockPanel.Dock="Left"><TextBlock Text="Devolucoes" FontSize="28" FontWeight="SemiBold" Foreground="#172033" /><TextBlock Text="Quadro de tarefas" FontSize="14" Foreground="#61708A" Margin="0,4,0,0" /></StackPanel><Border DockPanel.Dock="Right" Background="#E7F6EC" CornerRadius="12" Padding="12,7" VerticalAlignment="Center"><TextBlock Text="Sincronizacao local ativa" Foreground="#237A45" FontWeight="SemiBold" /></Border></DockPanel>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding Columns}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
            <Border Width="260" Margin="0,0,16,0" Background="#E9EDF3" CornerRadius="14" Padding="13"><DockPanel><TextBlock DockPanel.Dock="Top" Text="{Binding Name}" FontWeight="SemiBold" Foreground="#27344B" Margin="0,0,0,12" /><ItemsControl ItemsSource="{Binding Cards}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="White" CornerRadius="10" Padding="13" Margin="0,0,0,10"><StackPanel><TextBlock Text="{Binding CompanyName}" FontWeight="SemiBold" Foreground="#172033" TextWrapping="Wrap" /><TextBlock Text="{Binding TaxId}" Margin="0,4,0,0" Foreground="#61708A" FontSize="12" /><TextBlock Text="{Binding DeadlineLabel}" Margin="0,10,0,0" Foreground="#B25B13" FontWeight="SemiBold" FontSize="12" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></DockPanel></Border>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
    </Grid>
</Window>
