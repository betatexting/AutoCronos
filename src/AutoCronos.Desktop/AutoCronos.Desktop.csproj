<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\arte\simbolo background.png" Link="Assets\background-symbol.png" />
    <Resource Include="..\..\arte\fontes\BEBAS_NEUE\BebasNeue-Regular.ttf" Link="Assets\Fonts\BebasNeue-Regular.ttf" />
    <Resource Include="..\..\arte\fontes\HORIZON\Horizon.otf" Link="Assets\Fonts\Horizon.otf" />
  </ItemGroup>

  <ItemGroup Condition="'$(Suite360ApiKeyFile)' != '' and Exists('$(Suite360ApiKeyFile)')">
    <EmbeddedResource Include="$(Suite360ApiKeyFile)" LogicalName="AutoCronos.Suite360ApiKey" />
  </ItemGroup>

</Project>
